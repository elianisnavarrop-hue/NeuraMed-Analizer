                    <property name="styleSheet">
                     <string notr="true">QSpinBox {
    background-color: #0d0d0d;        /* Fondo oscuro */
    border: 1px solid #00FFFF;        /* Borde cian */
    color: #00FFFF;                   /* Texto cian */
    border-radius: 4px;
    padding: 2px;
    selection-background-color: #00FFFF;
    selection-color: #000000;
}

QSpinBox::up-button {
    background-color: #1a1a1a;        /* Fondo del botón */
    border: 1px solid #00FFFF;
    subcontrol-origin: border;
    subcontrol-position: top right;   /* Posición flecha arriba */
    width: 16px;
}

QSpinBox::down-button {
    background-color: #1a1a1a;        /* Fondo del botón */
    border: 1px solid #00FFFF;
    subcontrol-origin: border;
    subcontrol-position: bottom right; /* Posición flecha abajo */
    width: 16px;
}</string>
